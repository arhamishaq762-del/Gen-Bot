# ==== Discord Bot Credentials (get these from https://discord.com/developers/applications) ====
# NEVER commit the real .env file. NEVER paste real values into AI chats.
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-oauth2-client-secret

# ==== Web Dashboard ====
# Public URL of the dashboard (used for OAuth2 redirect). e.g. https://yourdomain.com
BASE_URL=http://localhost:3000
PORT=3000

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "production" when deployed behind HTTPS (enables secure cookies)
NODE_ENV=development

# Set DEMO_MODE=true to run the dashboard with mock data and no Discord credentials
DEMO_MODE=false

# Comma-separated Discord user IDs allowed to open the /admin panel (bot owners)
ADMIN_USER_IDS=
